# Export these in the shell that starts Mingle. Never commit real credentials.
# Claude uses your existing local Claude Code login (`claude auth login`).
# Optional API key instead of that login (takes precedence; uses API billing):
# ANTHROPIC_API_KEY=
# Optional application settings:
# MINGLE_DATA_DIR=/absolute/path/to/mingle-data
# MINGLE_HOST=127.0.0.1
# MINGLE_PORT=4310
# MINGLE_WEB_DIST=/absolute/path/to/apps/web/dist
# MINGLE_WEB_PORT=5173
# MINGLE_ALLOWED_ORIGINS=http://127.0.0.1:5173
# MINGLE_NODE_EXECUTABLE=/absolute/path/to/node
# Legacy names remain accepted when the matching MINGLE_ variable is unset:
# RELAY_DATA_DIR=/absolute/path/to/relay-data
# RELAY_HOST=127.0.0.1
# RELAY_PORT=4310
# RELAY_WEB_DIST=/absolute/path/to/apps/web/dist
# RELAY_WEB_PORT=5173
# RELAY_ALLOWED_ORIGINS=http://127.0.0.1:5173
# RELAY_NODE_EXECUTABLE=/absolute/path/to/node
