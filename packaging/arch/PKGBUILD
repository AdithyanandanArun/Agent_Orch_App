pkgname=mingle-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='Local development workspace for independent coding-agent sessions'
provides=('relay-workspace-bin')
conflicts=('relay-workspace-bin')
replaces=('relay-workspace-bin')
arch=('x86_64')
url='https://github.com/AdithyanandanArun/Agent_Orch_App'
license=('unknown')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'libatomic'
  'libgcc'
  'libstdc++'
  'glib2'
  'glibc'
  'git'
  'gtk3'
  'libcups'
  'libdrm'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'xdg-utils'
)
options=('!strip' '!debug')

_archive="mingle-${pkgver}-linux-x64.tar.gz"
if [[ -f "${_archive}" ]]; then
  source=("${_archive}")
else
  source=("${_archive}::https://github.com/AdithyanandanArun/Agent_Orch_App/releases/download/v${pkgver}/mingle-${pkgver}-linux-x64.tar.gz")
fi
sha256sums=('551986c31b0ccdd72c1af903630ca78547040ab6f5cd25da530c3070e44b3ebb')

package() {
  local _release="${srcdir}/mingle-${pkgver}-linux-x64"
  local _app="${pkgdir}/opt/mingle"

  install -d "${_app}"
  cp -a "${_release}/." "${_app}/"
  chown -R root:root "${_app}"

  # Electron's Chromium sandbox requires setuid root; package extraction is root-owned.
  install -o root -g root -m 4755 "${_release}/chrome-sandbox" "${_app}/chrome-sandbox"

  install -d "${pkgdir}/usr/bin"
  ln -s /opt/mingle/mingle "${pkgdir}/usr/bin/mingle"
  install -Dm644 "${_release}/mingle.desktop" "${pkgdir}/usr/share/applications/mingle.desktop"
  install -Dm644 "${_release}/mingle.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/mingle.svg"

  install -d "${pkgdir}/usr/share/licenses/${pkgname}"
  cp -a "${_release}/resources/licenses/." "${pkgdir}/usr/share/licenses/${pkgname}/"
  chown -R root:root "${pkgdir}/usr/share/licenses/${pkgname}"
}
